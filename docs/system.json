{
  "version": 1,
  "layers": ["external", "ui", "api", "cli", "service", "core", "data", "tooling", "docs"],
  "components": [
    {"id": "claude-code", "name": "Claude Code", "layer": "external", "kind": "agent", "files": [],
     "notes": "The Claude Code CLI; its hooks call roadmap hook pre/post.", "tasks": ["R1.4"]},
    {"id": "cli", "name": "CLI", "layer": "cli", "kind": "tool",
     "files": ["bin/**", "roadmap/__init__.py", "roadmap/__main__.py", "roadmap/cli.py", "roadmap/commands/**"],
     "entry": "bin/roadmap", "notes": "argparse tree; one module per command group in roadmap/commands.",
     "tasks": ["R1.1", "R10.26"]},
    {"id": "hooks", "name": "Hooks", "layer": "service", "kind": "service", "files": ["roadmap/services/hooks.py"],
     "notes": "Claude Code hook handling; roadmap hooks install is manual only.", "tasks": ["R1.4", "R1.8"]},
    {"id": "services", "name": "Services", "layer": "service", "kind": "service", "files": ["roadmap/services/**"],
     "notes": "Use-case logic: tasks, jobs, head, git ops, usage, system map.",
     "tasks": ["R1.4", "R1.6", "R1.9", "R10.19", "R10.20", "R11.101"]},
    {"id": "http-api", "name": "HTTP API", "layer": "api", "kind": "service", "files": ["roadmap/http/**"],
     "entry": "roadmap/http/server.py", "notes": "Local server on localhost; JSON routes under /api/v1.",
     "tasks": ["R1.5", "R10.21"]},
    {"id": "core", "name": "Core", "layer": "core", "kind": "module",
     "files": ["roadmap/core/**", "roadmap/errors.py", "roadmap/log.py"],
     "notes": "Pure parsing, formatting and snapshot logic; no I/O policy."},
    {"id": "store", "name": "Store", "layer": "data", "kind": "store",
     "files": ["roadmap/store/**", "roadmap/templates/**", "docs/*.json", "docs/*.jsonl"],
     "notes": "Per-project JSON and JSONL state under docs/ and the global roadmap home.", "tasks": ["R7.96"]},
    {"id": "web-shell", "name": "Web shell", "layer": "ui", "kind": "module",
     "files": ["web/index.html", "web/legacy.html", "web/icons.svg", "web/js/*.js", "web/css/**"],
     "entry": "web/index.html", "notes": "SPA shell: hash router, state, api client, shared CSS.",
     "tasks": ["R1.7", "R10.17"]},
    {"id": "views", "name": "Views", "layer": "ui", "kind": "module", "files": ["web/js/views/**"],
     "notes": "One file per section; each renders into the shell.",
     "tasks": ["R10.23", "R11.104", "R11.105", "R11.106", "R11.110"]},
    {"id": "graph-engine", "name": "Graph engine", "layer": "ui", "kind": "module", "files": ["web/js/graph/**"],
     "notes": "SVG graph drawing used by the workflow and system views.", "tasks": ["R11.107", "R11.108"]},
    {"id": "web-vendor", "name": "Web vendor", "layer": "ui", "kind": "module", "files": ["web/vendor/**"],
     "notes": "Third-party browser libraries with their licences."},
    {"id": "tests", "name": "Tests", "layer": "tooling", "kind": "tool",
     "files": ["tests/**", "web/dev/**", "fixtures/**"], "notes": "unittest suites, web tests and demo fixtures."},
    {"id": "tools", "name": "Tools", "layer": "tooling", "kind": "tool",
     "files": ["tools/**", "Makefile", ".editorconfig", ".gitignore"], "notes": "make check, lint and UI smoke scripts."},
    {"id": "docs", "name": "Docs", "layer": "docs", "kind": "store",
     "files": ["docs/**", "changes/**", "CLAUDE.md", "README.md", "CONTRIBUTING.md", "CHANGELOG.md", "LICENSE", ".claude/skills/**"],
     "notes": "Specs, runbooks, the handover and change notes.", "tasks": ["R11.111"]}
  ],
  "edges": [
    {"from": "claude-code", "to": "hooks", "label": "PreToolUse / PostToolUse hooks", "kind": "event"},
    {"from": "hooks", "to": "services", "label": "gate and record jobs", "kind": "call"},
    {"from": "cli", "to": "services", "label": "roadmap commands", "kind": "call"},
    {"from": "web-shell", "to": "http-api", "label": "GET snapshot, POST commands", "kind": "call"},
    {"from": "web-shell", "to": "views", "label": "renders the active route", "kind": "call"},
    {"from": "views", "to": "graph-engine", "label": "draws maps and graphs", "kind": "call"},
    {"from": "http-api", "to": "services", "label": "calls use cases", "kind": "call"},
    {"from": "services", "to": "core", "label": "parse and format", "kind": "call"},
    {"from": "services", "to": "store", "label": "read and write state", "kind": "data"}
  ],
  "external": [
    {"id": "agy", "name": "agy (Gemini staffer)"},
    {"id": "cursor", "name": "Cursor (review agent)"}
  ],
  "deployment": {
    "nodes": [
      {"id": "dev", "label": "This Mac", "sub": "launchd service on 127.0.0.1:8780", "kind": "device", "group": "dev"}
    ]
  },
 "containers": [
  {"id": "web", "name": "Web dashboard", "tech": "HTML/JS SPA in the browser", "components": ["web-shell", "views", "graph-engine", "web-vendor"], "notes": "Hash-routed single page; polls the snapshot every 2 s and posts registry ops."},
  {"id": "py", "name": "roadmap process", "tech": "Python: CLI + local HTTP server", "components": ["cli", "hooks", "http-api", "services", "core", "store"], "notes": "One package, two entry modes: bin/roadmap <command> and roadmap serve on 127.0.0.1."},
  {"id": "tools", "name": "Dev tools", "tech": "Python and shell", "components": ["tools"], "notes": "Checks, linters, UI smoke and agent job scripts."}],
 "flows": [
  {"id": "page-refresh", "name": "Dashboard refresh", "notes": "Every 2 s the page reads one snapshot per project and redraws the active section.", "steps": [
    {"from": "user", "to": "web-shell", "label": "open #/p/<id>/<section>"},
    {"from": "web-shell", "to": "http-api", "label": "GET /api/v1/projects/<id>/snapshot"},
    {"from": "http-api", "to": "services", "label": "build snapshot"},
    {"from": "services", "to": "store", "label": "read tasks, jobs, work"},
    {"from": "services", "to": "core", "label": "parse and summarise"},
    {"from": "http-api", "to": "web-shell", "label": "200 JSON (ETag)", "reply": true},
    {"from": "web-shell", "to": "views", "label": "render the section"},
    {"from": "views", "to": "graph-engine", "label": "layout and draw maps"}]},
  {"id": "board-action", "name": "Board action", "notes": "A click in the UI becomes one registry op; the write is atomic and logged.", "steps": [
    {"from": "user", "to": "views", "label": "click (move, accept, answer)"},
    {"from": "views", "to": "http-api", "label": "POST /api/v1/cmd {op, args}"},
    {"from": "http-api", "to": "http-api", "label": "CSRF, origin, rate limit"},
    {"from": "http-api", "to": "services", "label": "run the op"},
    {"from": "services", "to": "store", "label": "lock, atomic write, activity line"},
    {"from": "http-api", "to": "views", "label": "200 result + undo", "reply": true}]},
  {"id": "agent-job", "name": "Agent job recorded by hooks", "notes": "Claude Code calls the hook on every tool use; jobs open and close without manual steps.", "steps": [
    {"from": "claude-code", "to": "cli", "label": "roadmap hook (PreToolUse)"},
    {"from": "cli", "to": "hooks", "label": "run_hook(payload)"},
    {"from": "hooks", "to": "services", "label": "gate: allowed while blocked?"},
    {"from": "claude-code", "to": "cli", "label": "roadmap hook (PostToolUse)"},
    {"from": "cli", "to": "hooks", "label": "detect Agent / Bash job"},
    {"from": "hooks", "to": "services", "label": "start or close job"},
    {"from": "services", "to": "store", "label": "write jobs.json"}]},
  {"id": "cli-command", "name": "CLI command", "notes": "bin/roadmap <group> <command>: one module per group in roadmap/commands.", "steps": [
    {"from": "user", "to": "cli", "label": "bin/roadmap task done R1.2"},
    {"from": "cli", "to": "services", "label": "use case"},
    {"from": "services", "to": "store", "label": "read, lock, write"},
    {"from": "services", "to": "core", "label": "validate and format"},
    {"from": "cli", "to": "user", "label": "text or --json", "reply": true}]}]
}
